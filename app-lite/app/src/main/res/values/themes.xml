<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StrideLite" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/stride_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/stride_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/stride_accent</item>
        <item name="colorSecondary">@color/stride_accent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@color/stride_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/stride_accent</item>
        <item name="android:colorBackground">@color/stride_canvas</item>
        <item name="colorSurface">@color/stride_surface</item>
        <item name="colorSurfaceContainer">@color/stride_surface</item>
        <item name="colorSurfaceVariant">@color/stride_surface_alt</item>
        <item name="colorOnSurface">@color/stride_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/stride_text_secondary</item>
        <item name="colorOutline">@color/stride_border</item>
        <item name="colorError">@color/stride_danger</item>
        <item name="android:statusBarColor">@color/stride_elevated</item>
        <item name="android:navigationBarColor">@color/stride_elevated</item>
    </style>

    <style name="StrideCardStyle" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/stride_surface</item>
        <item name="strokeColor">@color/stride_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="StrideChipChoice" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/stride_surface_alt</item>
    </style>
</resources>

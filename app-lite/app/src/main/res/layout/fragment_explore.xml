<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleExploreMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:checkedButton="@id/btnExploreSegments"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreSegments"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Segments" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreRoutes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Routes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreHeatmap"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Heatmap" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/heatmapPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHeatmapSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/stride_text_secondary"
            android:textSize="13sp" />

        <com.stride.tracker.lite.ui.views.StrideRouteMapView
            android:id="@+id/heatmapView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeExplore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExplore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>

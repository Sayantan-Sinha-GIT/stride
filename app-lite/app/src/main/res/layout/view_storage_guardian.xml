<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/StrideCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeColor="@color/stride_accent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvStorageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage &amp; Cache Guardian"
            android:textColor="@color/stride_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStorageBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/stride_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressCacheQuota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:trackCornerRadius="4dp" />

        <TextView
            android:id="@+id/tvCacheCapLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Max Disk Cache Cap"
            android:textColor="@color/stride_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleCacheCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCap1Mb" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1 MB" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCap2Mb" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2 MB" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCap5Mb" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5 MB" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDataSaver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Data Saver (disable raster map tiles)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoPurge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Purge Cache on Close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearCacheNow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="Clear Cache &amp; Compact DB"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_storage" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

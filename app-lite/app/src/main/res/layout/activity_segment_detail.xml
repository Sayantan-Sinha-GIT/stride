<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/stride_canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSegment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/stride_elevated"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/stride_text_primary"
        app:titleTextColor="@color/stride_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <com.stride.tracker.lite.ui.views.StrideRouteMapView
            android:id="@+id/mapSegmentDetail"
            android:layout_width="match_parent"
            android:layout_height="180dp" />

        <TextView
            android:id="@+id/tvSegDetailSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/stride_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLbRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLbAll"
                style="@style/StrideChipChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Time" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLbYear"
                style="@style/StrideChipChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Year" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLbMonth"
                style="@style/StrideChipChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLbFollowing"
                style="@style/StrideChipChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Following" />
        </com.google.android.material.chip.ChipGroup>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
